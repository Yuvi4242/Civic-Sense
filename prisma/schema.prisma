generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  DEPARTMENT_STAFF
  ADMIN
}

enum Severity {
  MINOR
  MODERATE
  SEVERE
}

enum ComplaintStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(CITIZEN)
  departmentId  String?
  department    Department?     @relation(fields: [departmentId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  complaints    Complaint[]     @relation("CitizenComplaints")
  statusLogs    StatusHistory[] @relation("UserStatusLogs")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Department {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  users         User[]
  categoryRules CategoryRule[]
  complaints    Complaint[]
}

model CategoryRule {
  id           String     @id @default(cuid())
  category     String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  slaHours     Int
}

model Complaint {
  id               String          @id @default(cuid())
  citizenId        String
  citizen          User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  description      String
  photoUrl         String
  resolvedPhotoUrl String?
  latitude         Float?
  longitude        Float?
  addressText      String?
  category         String
  severity         Severity        @default(MINOR)
  confidence       Float           @default(1.0)
  needsHumanReview Boolean         @default(false)
  departmentId     String
  department       Department      @relation(fields: [departmentId], references: [id])
  slaHours         Int
  slaDeadline      DateTime
  status           ComplaintStatus @default(SUBMITTED)
  createdAt        DateTime        @default(now())
  acknowledgedAt   DateTime?
  inProgressAt     DateTime?
  resolvedAt       DateTime?

  statusHistory    StatusHistory[]

  @@index([departmentId])
  @@index([status])
  @@index([citizenId])
  @@index([category])
}

model StatusHistory {
  id          String          @id @default(cuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      ComplaintStatus
  note        String?
  changedById String
  changedBy   User            @relation("UserStatusLogs", fields: [changedById], references: [id])
  changedAt   DateTime        @default(now())

  @@index([complaintId])
}
